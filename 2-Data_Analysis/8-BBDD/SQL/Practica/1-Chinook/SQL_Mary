Segunda Parte

#1
SELECT
    c.FirstName,
    c.LastName,
    i.InvoiceId,
    i.InvoiceDate,
    i.BillingCountry
FROM customers c
JOIN invoices i
	ON c.CustomerId = i.CustomerId
	WHERE c.Country = 'Brazil';

#2
SELECT
    i.InvoiceId,
    e.FirstName,
    e.LastName
FROM invoices i
JOIN customers c
    ON i.CustomerId = c.CustomerId
JOIN employees e
    ON c.SupportRepId = e.EmployeeId;    

#3
SELECT
	i.Total,
	c.FirstName AS CustomerName,
	c.Country,
	e.FirstName AS AgentName
FROM customers c
JOIN  employees e 
	ON c.SupportRepId = e.EmployeeId 
JOIN invoices i 
	ON c.CustomerId = i.CustomerId;

#4
SELECT
	i.InvoiceLineId,
	t.Name
FROM invoice_items i
JOIN tracks t
    ON i.TrackId = t.TrackId;    

